{
    "name": "kode/http-client",
    "description": "现代化、高性能的 PHP HTTP 客户端，支持多运行时环境（FPM、CLI、Swoole、Swow、Fiber）",
    "keywords": [
        "http",
        "client",
        "psr-18",
        "psr-17",
        "psr-7",
        "swoole",
        "swow",
        "fiber",
        "coroutine",
        "async",
        "concurrent",
        "middleware",
        "php83",
        "php84"
    ],
    "homepage": "https://github.com/kodephp/http-client",
    "license": "MIT",
    "version": "2.4.0",
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kodephp/http-client/issues",
        "source": "https://github.com/kodephp/http-client"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "kode/context": "^3.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "amphp/http-client": "^4.0|^5.0",
        "amphp/socket": "^1.0|^2.0",
        "guzzlehttp/psr7": "^2.6",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "ext-swoole": "用于 Swoole 协程驱动",
        "ext-swow": "用于 Swow 协程驱动",
        "ext-curl": "用于 Curl / Fiber 驱动及并发请求",
        "amphp/http-client": "用于 Amp 异步 HTTP 客户端驱动",
        "guzzlehttp/psr7": "PSR-7/PSR-17 消息实现（默认推荐）",
        "nyholm/psr7": "轻量级 PSR-7/PSR-17 消息实现",
        "psr/log": "用于 LoggingMiddleware 的 PSR-3 日志集成",
        "kode/fibers": "用于 Fiber 协程池和调度器"
    },
    "autoload": {
        "psr-4": {
            "Kode\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\HttpClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}
