{
    "name": "kode/http-client",
    "description": "现代化、高性能的 PHP HTTP 客户端，支持多运行时环境（FPM、CLI、Swoole、Swow、Fiber）",
    "keywords": [
        "http",
        "client",
        "psr-18",
        "psr-7",
        "swoole",
        "swow",
        "fiber",
        "coroutine",
        "async",
        "middleware",
        "php8"
    ],
    "homepage": "https://github.com/kodephp/http-client",
    "license": "Apache-2.0",
    "version": "2.2.1",
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kodephp/http-client/issues",
        "source": "https://github.com/kodephp/http-client"
    },
    "require": {
        "php": "^8.1",
        "kode/context": "^2.1",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "amphp/http-client": "^4.0",
        "amphp/socket": "^1.0",
        "guzzlehttp/psr7": "^2.1"
    },
    "suggest": {
        "ext-swoole": "用于 Swoole 协程支持",
        "ext-swow": "用于 Swow 协程支持",
        "amphp/http-client": "用于 Amp 异步 HTTP 客户端驱动",
        "guzzlehttp/psr7": "用于 PSR-7 消息实现"
    },
    "autoload": {
        "psr-4": {
            "Kode\\HttpClient\\": "src/",
            "Kode\\HttpClient\\Context\\": "src/Context/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\HttpClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "test-middlewares": "phpunit tests/MiddlewareTest.php"
    }
}
